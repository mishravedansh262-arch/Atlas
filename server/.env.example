# ATLAS server environment variables
# Copy this file to .env and adjust values for your machine.

# Server
# NOTE: avoid 5000/7000 on macOS — AirPlay Receiver occupies them.
PORT=8000
NODE_ENV=development

# CORS — origin of the Vite frontend dev server
CLIENT_ORIGIN=http://localhost:5173

# Database — MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster-host>/atlas?retryWrites=true&w=majority
MONGODB_URI=

# Auth — generate a secret with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
